{
  "name": "Kranich Commons",
  "appTopic": "freedom-community/v0/app/kranich",
  "roles": [
    { "id": "owner", "name": "Owner", "permissions": ["*"] },
    { "id": "admin", "name": "Admin", "permissions": ["community.manage", "role.manage", "badge.manage", "badge.score", "quest.manage", "quest.review", "library.manage", "library.post", "mod.hide", "post.create", "comment.create", "like.set", "profile.set", "quest.submit"] },
    { "id": "moderator", "name": "Moderator", "permissions": ["mod.hide", "quest.review"] },
    { "id": "member", "name": "Member", "permissions": ["post.create", "comment.create", "like.set", "profile.set", "quest.submit"] }
  ],
  "defaultRoles": ["member"],
  "badges": [
    { "id": "crane-spotter", "name": "Crane spotter", "description": "Counts cranes on the autumn flyway.", "roles": [], "default": true, "visibility": "everywhere",
