    { "id": "warden", "name": "Warden", "description": "Keeps the commons tidy.", "roles": ["moderator"] }
  ],
  "categories": [
    { "id": "counts", "name": "Counts", "color": "#2b3a55" },
    { "id": "trips", "name": "Trips", "color": "#d4794a" },
    { "id": "photos", "name": "Photos", "color": "#5b7f4a" }
  ],
  "theme": { "primary": "#2b3a55", "accent": "#d4794a" },
  "settings": { "public": true }
}
